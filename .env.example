# ── LLM Provider (Ollama Local Offline) ────────────────────────────
LLM_PROVIDER="ollama"

# Offline Local LLM (Ollama) Settings
# Use http://localhost:11434 for local dev, or http://host.docker.internal:11434 inside Docker
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss"

# ── Task Routing Overrides (Optional) ───────────────
# ASSESSMENT_MODEL="gpt-oss"
# RAG_MODEL="gpt-oss"
# STRATEGY_MODEL="gpt-oss"

# APP_URL: The base URL where this application is hosted.
APP_URL="MY_APP_URL"
