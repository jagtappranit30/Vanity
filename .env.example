# Global Provider Selection: "gemini" (cloud) or "ollama" (local offline)
LLM_PROVIDER="gemini"

# Google Gemini Cloud API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Offline Local LLM (Ollama) Settings
# Use http://localhost:11434 for local dev, or http://host.docker.internal:11434 inside Docker
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss"

# ── Multi-LLM Task Routing Overrides (Optional) ───────────────
# Task 1: Financial Document Assessment & Data Extraction
# ASSESSMENT_LLM_PROVIDER="ollama"
# ASSESSMENT_MODEL="gpt-oss"

# Task 2: Vector RAG Document Q&A & Citation Lookup
# RAG_LLM_PROVIDER="ollama"
# RAG_MODEL="gpt-oss"

# Task 3: Sector Benchmarking & Strategy Generation
# STRATEGY_LLM_PROVIDER="ollama"
# STRATEGY_MODEL="gpt-oss"

# APP_URL: The base URL where this application is hosted.
APP_URL="MY_APP_URL"
